// Windows version resource for TechAim.exe (P0 Phase C).
//
// Authored explicitly rather than generated from QMAKE_TARGET_*, because
// qmake's generated resource leaves InternalName empty and emits
// FILETYPE VFT_DLL for an application. This file is the auditable input to
// the future signing pipeline, so every field is stated.
//
// Keep in step with src/app/ProductIdentity.cpp and APP_VERSION_STR in
// Seta.pro. Deliberately makes NO certification claim: this is a pre-beta
// validation build, not certified, not ISSF-approved, not SETA-approved.

#include <windows.h>

// The Windows application icon. The LOWEST-numbered icon resource is what
// Explorer, the taskbar and shortcuts use, so this must stay first. Each
// flavour ships its OWN icon, selected here rather than by overwriting a shared
// file: a Tech Aim build must keep the Tech Aim emblem byte for byte, and a
// SETA build must not go out wearing it.
//
// BRAND_SETA reaches the resource compiler through RC_DEFINES in Seta.pro - the
// same define the C++ already uses, so the icon on the executable cannot
// disagree with the product identity compiled into it.
#ifdef BRAND_SETA
// The SETA target emblem, cropped from the approved images/logo/seta.png by
// tools/icon/make_seta_ico.py. 7 sizes, 16..256.
IDI_TECHAIM ICON "images/logo/seta.ico"
#else
// The approved Tech Aim target emblem (images/logo/techaim_color.png).
IDI_TECHAIM ICON "images/logo/techaim.ico"
#endif

#define IDI_TECHAIM 101

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    1,0,0,0
    PRODUCTVERSION 1,0,0,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG | VS_FF_PRERELEASE
#else
    FILEFLAGS      VS_FF_PRERELEASE
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"        // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "JAC SHOOTING SOLUTIONS (PTY) LTD\0"
#ifdef BRAND_SETA
            VALUE "FileDescription",  "SETA Electronic Target Control\0"
#else
            VALUE "FileDescription",  "Tech Aim Electronic Target Control\0"
#endif
            VALUE "FileVersion",      "1.0.0.0\0"
#ifdef BRAND_SETA
            VALUE "InternalName",     "SETA\0"
#else
            VALUE "InternalName",     "TechAim\0"
#endif
            VALUE "LegalCopyright",   "Copyright (C) JAC SHOOTING SOLUTIONS (PTY) LTD\0"
#ifdef BRAND_SETA
            VALUE "OriginalFilename", "SETA.exe\0"
#else
            VALUE "OriginalFilename", "TechAim.exe\0"
#endif
#ifdef BRAND_SETA
            VALUE "ProductName",      "SETA Electronic Target Control\0"
#else
            VALUE "ProductName",      "Tech Aim Electronic Target Control\0"
#endif
            VALUE "ProductVersion",   "1.0.0.0\0"
            VALUE "Comments",         "Windows Pre-Beta Validation Build\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
